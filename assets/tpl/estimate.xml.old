<content name="見積書テンプレート">
    <head>
        <font name="ES_Regular" size="9.5" color="333333" src="../font/GenShinGothic-P-Regular.ttf" />
        <font name="Bold" size="16" color="333333" src="../font/GenShinGothic-P-Bold.ttf" />
        <font name="Heavy" size="19" color="333333" src="../font/GenShinGothic-P-Heavy.ttf" />
    </head>

	<doc page_size="HPDF_PAGE_SIZE_A4" landscape="HPDF_PAGE_PORTRAIT" language="JP">

		<textarea font="Regular" position_x="25" position_y="87" width="150" height="50"
				summary="見積りのご案内" border_bottom="1" border_color="666666">
			<text>下記の通りお見積り致しますので、</text><br />
